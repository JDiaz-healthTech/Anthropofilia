# --- Seguridad básica: impedir ejecución de código PHP ---
php_flag engine off
Options -ExecCGI

# --- Evita listado de directorios ---
Options -Indexes

# --- MIME Types correctos para imágenes ---
<IfModule mod_mime.c>
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/gif .gif
  AddType image/webp .webp
</IfModule>

# --- Cabeceras de seguridad ---
<IfModule mod_headers.c>
  # Evita interpretación errónea de tipos MIME
  Header set X-Content-Type-Options "nosniff"
  # Previene que se embeba en iframes (clickjacking)
  Header set X-Frame-Options "SAMEORIGIN"
  # Oculta cabecera X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# --- Política de caché para archivos estáticos ---
<IfModule mod_expires.c>
  ExpiresActive On
  # 1 mes para imágenes
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>

# --- Permitir acceso a imágenes ---
<FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
  Require all granted
</FilesMatch>

# --- Bloquear ejecución de archivos peligrosos ---
<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|cgi|asp|aspx|sh|exe|bat)$">
  Require all denied
</FilesMatch>